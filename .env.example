# .env.example
# Copy this file to .env before running `docker compose up`

# Application Environment
FLASK_ENV=development
FLASK_DEBUG=true

# Database Connection (Hardcoded to local dummy container, NOT staging)
DB_USER=local_admin
DB_PASSWORD=local_dummy_password
DB_NAME=rickmorty

# Exposed Host Ports
HOST_API_PORT=5000
HOST_DB_PORT=127.0.0.1:5432
HOST_REDIS_PORT=127.0.0.1:6379

# Logging
LOG_FORMAT=text
LOG_LEVEL=DEBUG
