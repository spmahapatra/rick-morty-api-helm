# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=dev-secret-key-change-in-prod

# Database Configuration
DATABASE_URL=postgresql://admin:password@localhost:5432/rickmorty
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
REDIS_SOCKET_TIMEOUT=5
REDIS_ENABLE_CACHE=true

# Caching Configuration
CACHE_DEFAULT_TTL=3600
CACHE_COLLECTION_TTL=300
CACHE_INDIVIDUAL_TTL=3600

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC=100
RATE_LIMIT_STANDARD=1000
RATE_LIMIT_PREMIUM=5000

# Resilience Configuration
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=60.0
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=60

# Timeout Configuration (seconds)
UPSTREAM_API_TIMEOUT=10
DATABASE_TIMEOUT=30
CACHE_TIMEOUT=5

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_CORRELATION_ID=true

# Rick and Morty API Configuration
RICK_AND_MORTY_API_BASE_URL=https://rickandmortyapi.com/api

# Features
ENABLE_PERSISTENCE=true
ENABLE_HEALTH_CHECK=true
ENABLE_METRICS=true
