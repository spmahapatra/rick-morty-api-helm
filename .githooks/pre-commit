#!/bin/bash
# .git/hooks/pre-commit

echo "==========================================="
echo "Running Local Pre-Commit Validations..."
echo "==========================================="

echo "1. Checking Documentation Organization..."
ROOT_MDS=$(find . -maxdepth 1 -name "*.md" -not -name "README.md" -not -name "GEMINI.md" -type f)
ROOT_COUNT=$(echo "$ROOT_MDS" | grep -c . || true)
if [ $ROOT_COUNT -gt 0 ]; then
  echo "❌ Error: Found $ROOT_COUNT markdown file(s) in root directory!"
  echo "All documentation (except README.md and GEMINI.md) must be in docs/."
  echo "Files found:"
  echo "$ROOT_MDS"
  echo "Commit aborted."
  exit 1
else
  echo "✅ Docs organized correctly."
fi

echo "2. Running Security Scans (Bandit)..."
if command -v bandit &> /dev/null; then
  if ! bandit -r src -ll -i -q; then
    echo "❌ Bandit security scan failed! Fix the vulnerabilities."
    exit 1
  fi
  echo "✅ Bandit passed."
else
  echo "⚠️  Bandit not installed locally, skipping."
fi

echo "3. Syncing AI Enterprise Instructions..."
~/.gemini/config/scripts/export-ai-rules.py > /dev/null

# Copy AI rules directly into the repo so Copilot/Cursor detect them natively
cp -r ~/.gemini/config/exports/github-copilot/.github/ . 2>/dev/null || true
cp -r ~/.gemini/config/exports/cursor-ide/.cursor/ . 2>/dev/null || true

# Copy Claude, ChatGPT, and Ollama assets to docs/ai-instructions
mkdir -p docs/ai-instructions/
cp -r ~/.gemini/config/exports/claude-projects/ docs/ai-instructions/ 2>/dev/null || true
cp -r ~/.gemini/config/exports/chatgpt-custom-gpts/ docs/ai-instructions/ 2>/dev/null || true
cp -r ~/.gemini/config/exports/ollama/ docs/ai-instructions/ 2>/dev/null || true

# Automatically stage the synced AI instructions
git add .github/ .cursor/ docs/ai-instructions/

echo "==========================================="
echo "✅ All local pre-commit checks passed! Committing..."
echo "==========================================="
exit 0

# ==========================================
# 4. Global AI Dotfiles Auto-Sync
# ==========================================
echo "4. Checking global ~/ai-dotfiles for uncommitted changes..."
cd ~/ai-dotfiles || exit 0
if [[ -n $(git status -s) ]]; then
    echo "   -> Found changes in global AI dotfiles! Auto-committing them now..."
    ./scripts/export-ai-rules.py > /dev/null 2>&1
    git add .
    git commit -m "chore: auto-sync AI dotfiles (triggered by project commit)" > /dev/null
    echo "   ✅ Global dotfiles successfully backed up."
else
    echo "   ✅ Global dotfiles are already up to date."
fi
# Return to the original project directory to finish the project commit
cd - > /dev/null
